<?php
declare(strict_types=1);

use Magento\Catalog\Block\Product\View;
use Magento\Framework\Escaper;

/** @var View $block */
/** @var Escaper $escaper */

$product = $block->getProduct();
if (!$product) {
    return;
}

$image = $block->getImage($product, 'product_page_image_small');
?>

<div x-data="initAddToCartPopup()"
     x-cloak>
    <div class="fixed inset-0 z-50 flex items-center justify-center w-full bg-black/50"
         x-show="open"
         x-transition.opacity
         @keydown.esc.window="close()"
         @click.self="close()">

        <div class="w-5/6 sm:w-[500px] flex flex-col items-center bg-white rounded-md"
             role="dialog"
             aria-modal="true"
        >
            <!-- Header of the modal -->
            <div class="w-full flex justify-center border-b mb-2 font-semibold">
                <p class="p-4">
                    <?= $escaper->escapeHtml(__('The item was added to your cart')); ?>
                </p>
            </div>
            <!-- Image and name -->
            <div class="flex justify-start items-center gap-2 w-full p-2">
                <img class="w-20 h-20 object-contain"
                     src="<?= $escaper->escapeUrl($image->getImageUrl()); ?>"
                     width="<?= (int) $image->getWidth(); ?>"
                     height="<?= (int) $image->getHeight(); ?>"
                     alt="<?= $escaper->escapeHtmlAttr($product->getName()); ?>"
                >
                <p>
                    <?= $escaper->escapeHtml($product->getName()) ?>
                </p>
            </div>
            <!-- Buttons -->
            <div class="w-full flex flex-col sm:flex-row text-white gap-2 sm:gap-6 p-4">
                <button class="btn w-full"
                        type="button"
                        @click="close()"
                >
                    <?= $escaper->escapeHtml(__('Continue shopping')) ?>
                </button>
                <a class="btn btn-primary w-full"
                   href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"
                >
                    <?= $escaper->escapeHtml(__('Go to cart')) ?>
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    function initAddToCartPopup() {
        return {
            open: false,

            init() {
                const form = document.getElementById('product_addtocart_form');

                if (!form) return;

                form.addEventListener('submit', (event) => {
                    this.handleSubmit(event, form)
                })
            },

            async handleSubmit(event, form) {
                // Prevent the page from reloading
                event.preventDefault();

                // Use AJAX to add a product to the cart without refreshing the page
                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                    });

                    if (!response.ok) {
                        throw new Error(
                            `The product failed to be added to the cart: ${response.status}`
                        )
                    }

                    const result = await response.json();

                    // Follow Magento's default redirect behavior when a direct URL is returned
                    if (result.backUrl) {
                        window.location.href = result.backUrl;
                        return;
                    }

                    // Refresh Hyva's customer section data so the mini-cart is updated
                    window.dispatchEvent(
                        new Event('reload-customer-section-data')
                    );

                    this.show();

                } catch (error) {
                    // Fall back to Magento's normal form of submission if AJAX fails
                    console.error('Add to cart failed:', error.message);
                    form.submit();
                }
            },

            // Open the pop-up
            show() {
                this.open = true;
            },

            // Close the pop-up
            close() {
                this.open = false;
            }
        }
    }
</script>

