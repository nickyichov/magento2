<?php
declare(strict_types=1);

use Magento\Catalog\Block\Product\View;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template|View $block */
/** @var Escaper $escaper */

// On the product page the product is known server-side; on listing pages
// the name and image are read from the submitted product item instead.
$pageProduct = null;
if ($block instanceof View && ($product = $block->getProduct())) {
    $pageProduct = [
        'name' => $product->getName(),
        'image' => $block->getImage($product, 'product_page_image_small')->getImageUrl(),
    ];
}
?>

<div x-data="initAddToCartPopup(<?= $escaper->escapeHtmlAttr(json_encode($pageProduct)) ?>)"
     x-cloak>
    <div class="fixed inset-0 z-50 flex items-center justify-center w-full bg-black/50"
         x-show="open"
         x-transition.opacity
         @keydown.esc.window="close()"
         @click.self="close()">

        <div class="w-5/6 sm:w-[500px] flex flex-col items-center bg-white rounded-md"
             role="dialog"
             aria-modal="true"
        >
            <!-- Header of the modal -->
            <div class="w-full flex justify-center border-b mb-2 font-semibold">
                <p class="p-4">
                    <?= $escaper->escapeHtml(__('The item was added to your cart')); ?>
                </p>
            </div>
            <!-- Image and name -->
            <div class="flex justify-start items-center gap-2 w-full p-2">
                <template x-if="product.image">
                    <img class="w-20 h-20 object-contain"
                         :src="product.image"
                         :alt="product.name"
                         width="80"
                         height="80"
                    >
                </template>
                <p x-text="product.name"></p>
            </div>
            <!-- Buttons -->
            <div class="w-full flex flex-col sm:flex-row text-white gap-2 sm:gap-6 p-4">
                <button class="btn w-full"
                        type="button"
                        @click="close()"
                >
                    <?= $escaper->escapeHtml(__('Continue shopping')) ?>
                </button>
                <a class="btn btn-primary w-full"
                   href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"
                >
                    <?= $escaper->escapeHtml(__('Go to cart')) ?>
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    function initAddToCartPopup(pageProduct) {
        return {
            open: false,
            product: { name: '', image: '' },

            init() {
                // Listen on the document so product forms rendered later (e.g. in sliders) are handled too
                document.addEventListener('submit', (event) => {
                    const form = event.target;

                    // Only the product page form and the product item forms on listings
                    if (!form.matches('#product_addtocart_form, form.product_addtocart_form')) return;

                    // Another script has already taken care of this submit
                    if (event.defaultPrevented) return;

                    this.handleSubmit(event, form);
                })
            },

            // Name and image of the product that belongs to the submitted form
            getProductData(form) {
                if (form.id === 'product_addtocart_form' && pageProduct) {
                    return pageProduct;
                }

                const name = form.querySelector('.product-item-link');
                const image = form.querySelector('.product-item-photo img');

                return {
                    name: name ? name.textContent.trim() : '',
                    image: image ? (image.currentSrc || image.src) : ''
                };
            },

            async handleSubmit(event, form) {
                // Prevent the page from reloading
                event.preventDefault();

                // Listing forms use a %uenc% placeholder that Hyva only replaces on a normal submit
                form.action = form.action.replace('%25uenc%25', hyva.getUenc());

                // Use AJAX to add a product to the cart without refreshing the page
                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                    });

                    if (!response.ok) {
                        throw new Error(
                            `The product failed to be added to the cart: ${response.status}`
                        )
                    }

                    const result = await response.json();

                    // Follow Magento's default redirect behavior when a direct URL is returned
                    // (e.g. a configurable product from the listing that still needs options)
                    if (result.backUrl) {
                        window.location.href = result.backUrl;
                        return;
                    }

                    // Refresh Hyva's customer section data so the mini-cart is updated
                    window.dispatchEvent(
                        new Event('reload-customer-section-data')
                    );

                    this.show(this.getProductData(form));

                } catch (error) {
                    // Fall back to Magento's normal form of submission if AJAX fails
                    console.error('Add to cart failed:', error.message);
                    form.submit();
                }
            },

            // Open the pop-up
            show(product) {
                this.product = product;
                this.open = true;
            },

            // Close the pop-up
            close() {
                this.open = false;
            }
        }
    }
</script>
